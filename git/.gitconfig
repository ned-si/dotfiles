# No default identity here on purpose. This repo is published, so it lives in an
# untracked file instead:
#
#   ~/.gitconfig.local             the default identity
#   ~/.config/git/config-personal  applied to repos with a personal remote
#
# ~/.gitconfig.local sits outside ~/.config/git deliberately: that directory is a
# stow symlink into this repo, so a local file there would land in the working
# tree and be one `git add -A` away from being published.
#
# Order matters. git applies each include where it appears and the last value
# wins, so the unconditional default has to come FIRST and the conditional
# override second. Reversed, config.local's identity would win everywhere and
# personal repos would quietly get committed under the work identity.
[include]
	# Untracked. Holds the default identity and anything not for publishing.
	path = ~/.gitconfig.local

# The includeIf below matches on the repo's REMOTE URL rather than its path,
# which matters because personal and work checkouts sit side by side in ~/repos
# and a gitdir: rule would need a special case for each one.
#
# Requires git >= 2.36.
[includeIf "hasconfig:remote.*.url:git@github.com:ned-si/**"]
	path = ~/.config/git/config-personal
[includeIf "hasconfig:remote.*.url:https://github.com/ned-si/**"]
	path = ~/.config/git/config-personal

[init]
	defaultBranch = main

[core]
	excludesfile = ~/.config/git/ignore
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	line-numbers = true
	hyperlinks = true
	syntax-theme = Catppuccin-mocha

[merge]
	# zdiff3 shows the common ancestor, which makes conflicts far easier to read.
	conflictstyle = zdiff3

[diff]
	algorithm = histogram
	colorMoved = default

[push]
	# Stop `git push` failing on a new branch just to tell you to set upstream.
	autoSetupRemote = true

[pull]
	rebase = true

[fetch]
	prune = true
	pruneTags = true

[rebase]
	autoStash = true
	autoSquash = true

[rerere]
	# Remember conflict resolutions and replay them.
	enabled = true

[branch]
	sort = -committerdate

[column]
	ui = auto

[commit]
	# Put the diff in the editor when writing a commit message.
	verbose = true

[help]
	autocorrect = prompt

[alias]
	s = status --short --branch
	lg = log --oneline --graph --decorate -20
	last = log -1 --stat
	unstage = restore --staged
	amend = commit --amend --no-edit
