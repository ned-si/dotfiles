# Deliberately minimal and free of internal hostnames, since this repo is
# published. Work hosts, jump boxes and anything else site-specific belong in
# ~/.ssh/config.local, which is not tracked.
#
# Include comes first on purpose: for most keywords ssh keeps the FIRST value it
# encounters, so a later block cannot override an earlier one. Putting the local
# file at the top is what lets it win.
Include ~/.ssh/config.local

Host *
	# Bitwarden serves both ssh-nedsi-main and ssh-work, so no private keys
	# are on disk. Set here as well as via SSH_AUTH_SOCK so GUI apps that do not
	# read the shell environment still find the agent.
	IdentityAgent ~/.bitwarden-ssh-agent.sock
	AddKeysToAgent yes
	ServerAliveInterval 60
	ServerAliveCountMax 3
