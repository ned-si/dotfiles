# Exact name of the bundled theme, which is capitalised and space-separated.
# "catppuccin-mocha" silently fails to resolve and Ghostty falls back to its
# default palette. Check available names with `ghostty +list-themes`.
theme = Catppuccin Mocha

# auto rather than none, so there is a titlebar to grab and move the window by.
# macos-titlebar-style defaults to transparent, so this costs very little screen
# space. Set to none to go back to a fully borderless window.
window-decoration = auto

# Send Option as Alt/Meta rather than letting macOS turn it into a special
# character. Without this, none of tmux's M- bindings can ever fire: Option+c
# gets swallowed by the input layer and tmux receives nothing.
#
# Scoped to Ghostty, so Option keeps its normal behaviour everywhere else. Use
# `left` instead of `true` to keep the right Option key for character input.
macos-option-as-alt = true

font-family = "JetBrainsMono Nerd Font Mono"
font-family-italic = "VictorMono Nerd Font Mono"
font-family-bold-italic = "VictorMono Nerd Font Mono"

# font-size = 10
keybind = ctrl+shift+kp_add=increase_font_size:1
keybind = ctrl+shift+-=decrease_font_size:1
